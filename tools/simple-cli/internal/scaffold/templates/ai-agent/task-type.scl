set dev_simple_system.task_type, {{.Key}} {
  name "{{.Name}}"
  plural_name "{{.PluralName}}"{{if .Description}}{{printf "\n  description \"%s\"" .Description}}{{end}}
  playbook_id `$app_record("{{.PlaybookKey}}")`
  schema `$file('{{.ShapePath}}') |> $json()`
  states `$file('{{.StatesPath}}') |> $json()`
  wake_interval_seconds {{.WakeIntervalSeconds}}
}
